{
  "name": "efra-rating-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "matrix": "node scripts/position-matrix.mjs",
    "registry:sql": "node scripts/generate-metric-registry.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && node --test test/*.test.ts",
    "test:postgres": "node --test test/postgres.integration.ts",
    "test:statistical-pilot": "node --test test/statistical-pilot.integration.ts",
    "test:neon-integration": "node --test test/neon.integration.ts",
    "test:secure-pipeline": "node --test test/secure-pipeline.integration.ts",
    "test:coverage": "npm run typecheck && node --test --experimental-test-coverage --test-coverage-include=src/** test/*.test.ts",
    "build:pilot-engine": "node scripts/build-pilot-engine.mjs",
    "pretest:secure-pipeline": "npm run build:pilot-engine",
    "pilot:verify": "node scripts/pilot/verify-infra.mjs",
    "source:matrix": "node scripts/source-evidence-matrix.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
