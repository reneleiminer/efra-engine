{
  "name": "efra-rating-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "matrix": "node scripts/position-matrix.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && node --test test/*.test.ts",
    "test:postgres": "node --test test/postgres.integration.ts",
    "test:neon-integration": "node --test test/neon.integration.ts",
    "test:coverage": "npm run typecheck && node --test --experimental-test-coverage --test-coverage-include=src/** test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "typescript": "5.9.3"
  }
}
